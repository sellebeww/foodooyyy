{
  "name": "foodoo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "backtest": "node --experimental-strip-types scripts/backtest.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "icons": "node --experimental-strip-types scripts/makeIcons.ts",
    "size": "node --experimental-strip-types scripts/bundleSize.ts",
    "contrast": "node --experimental-strip-types scripts/checkContrast.ts",
    "ui:shots": "node --experimental-strip-types scripts/uiShots.ts",
    "lighthouse": "node --experimental-strip-types scripts/lighthouse.ts"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "seedrandom": "3.0.5",
    "vite-plugin-pwa": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/jest-axe": "3.5.9",
    "@types/node": "22.20.5",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.7",
    "@types/seedrandom": "3.0.8",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jest-axe": "10.0.0",
    "jsdom": "28.1.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
